# Node 22.13+; copy to .env and generate DIFFERENT random values for the two devices.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHILD_DEVICE_TOKEN=
GUARDIAN_DEVICE_TOKEN=

# Create two different bots with @BotFather. Enable Bot-to-Bot Communication Mode
# for BOTH bots. No Telegram token is installed inside the Android app.
CHILD_BOT_TOKEN=
GUARDIAN_BOT_TOKEN=

HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/family.sqlite

# Optional: Firebase Admin service-account JSON FILE path (never commit this file).
# Use the same Firebase project as the Android app's google-services.json.
FIREBASE_SERVICE_ACCOUNT=

# Native Android requires no CORS. Leave blank unless you intentionally add a browser client.
# Exact allowed origins, separated by commas; '*' is rejected.
ALLOWED_ORIGINS=
